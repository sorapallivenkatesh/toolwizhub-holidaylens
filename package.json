{
  "name": "holidaylens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Indian state holidays + leave bridge optimizer (ToolWizHub)",
  "scripts": {
    "start": "concurrently -n api,ui -c cyan,magenta \"npm run dev\" \"npm run ui\"",
    "dev": "wrangler dev --port 8791",
    "deploy": "wrangler deploy",
    "deploy:ui": "npm run ui:build && wrangler pages deploy web/dist --project-name=toolwizhub-holidaylens",
    "build": "npm run ui:build",
    "typecheck": "tsc --noEmit",
    "validate:data": "tsx scripts/validate-data.ts",
    "preview:cards": "tsx scripts/preview.tsx",
    "ui": "npm --prefix web run dev",
    "ui:install": "npm --prefix web install",
    "ui:build": "npm --prefix web run build",
    "ui:preview": "npm --prefix web run preview"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "satori": "^0.12.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
